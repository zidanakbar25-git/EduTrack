<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog"
        android:padding="24dp">

        <!-- Header Dialog -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Tambah Tugas"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloseTugas"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="✕"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </RelativeLayout>

        <!-- Judul Tugas -->
        <EditText
            android:id="@+id/etJudulTugas"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_field"
            android:hint="Judul tugas"
            android:textColorHint="#BDBDBD"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:maxLength="150"
            android:autofillHints="none" />

        <!-- Dropdown Kategori -->
        <Spinner
            android:id="@+id/spinnerKategori"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_spinner"
            android:paddingHorizontal="16dp" />

        <!-- Dropdown Mata Kuliah -->
        <Spinner
            android:id="@+id/spinnerMatkul"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_spinner"
            android:paddingHorizontal="16dp" />

        <!-- Pilih Deadline -->
        <LinearLayout
            android:id="@+id/layoutDeadline"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_field"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_calendar"
                android:contentDescription="Kalender" />

            <TextView
                android:id="@+id/tvSelectedDeadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Pilih deadline"
                android:textColor="#BDBDBD"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Catatan / Deskripsi -->
        <EditText
            android:id="@+id/etCatatan"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_input_field"
            android:hint="Catatan (opsional)"
            android:textColorHint="#BDBDBD"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:padding="16dp"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:maxLength="500"
            android:autofillHints="none" />

        <!-- Tombol Simpan -->
        <Button
            android:id="@+id/btnSimpanTugas"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Simpan Tugas"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/accent_orange"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="14dp" />

    </LinearLayout>
</ScrollView>
