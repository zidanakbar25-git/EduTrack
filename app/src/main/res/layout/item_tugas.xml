<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Baris 1: Judul + Badge Kategori -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvJudulTugas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Judul Tugas"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBadgeKategori"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Tugas Biasa"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge"
                android:textColor="@color/badge_biasa_text" />
        </LinearLayout>

        <!-- Baris 2: Mata Kuliah -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_book"
                app:tint="@color/text_secondary"
                android:contentDescription="Mata Kuliah" />

            <TextView
                android:id="@+id/tvNamaMatkul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Nama Mata Kuliah"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Baris 3: Catatan (jika ada) -->
        <TextView
            android:id="@+id/tvCatatan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="catatan"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0"
            android:layout_marginVertical="12dp" />

        <!-- Baris 4: Deadline + Sisa Hari -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_calendar"
                android:contentDescription="Deadline" />

            <TextView
                android:id="@+id/tvDeadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="1 Agt 2026"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSisaHari"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 hari lagi"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/deadline_green" />
        </LinearLayout>

        <!-- Baris 5: Tombol Selesai + Gagal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:weightSum="2">

            <Button
                android:id="@+id/btnSelesai"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="✓  Selesai"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:backgroundTint="@color/btn_selesai"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnGagal"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="✗  Gagal"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:backgroundTint="@color/btn_gagal"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="10dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
